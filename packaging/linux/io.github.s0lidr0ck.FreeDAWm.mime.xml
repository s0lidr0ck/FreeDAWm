<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for FreeDAWm's session format (`.fdawm`; the older `.scraft`
     sessions keep their own type and still open). Audio and MIDI types come from
     the system database. Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-freedawm-session">
    <comment>FreeDAWm session</comment>
    <sub-class-of type="application/json"/>
    <icon name="io.github.s0lidr0ck.FreeDAWm"/>
    <glob pattern="*.fdawm"/>
  </mime-type>
  <mime-type type="application/x-soundcraft-session">
    <comment>FreeDAWm session (older .scraft)</comment>
    <sub-class-of type="application/json"/>
    <icon name="io.github.s0lidr0ck.FreeDAWm"/>
    <glob pattern="*.scraft"/>
  </mime-type>
</mime-info>
